      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Hãy cử tôi đi! Vì chính nghĩa, tôi sẽ giương cao cơ hội chiến thắng và trở về trong khải hoàn!",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 37,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Đừng lo lắng. Chừng này thì tôi sẽ hoàn thành cho xem!",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 38,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Làm được! Chẳng phải đây là thế gian mà nếu không nỗ lực thì không thể tiến lên phía trước sao!",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 39,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Tôi sẽ nỗ lực hết sức mình! Chẳng phải anh hùng là người hoàn thành được những việc không thể hoàn thành sao!",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 40,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "…Dẫu biết là liều lĩnh nhưng vẫn không dừng bước, đó chính là anh hùng!",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 41,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Tôi sẽ không dám tự phụ đâu! Chắc chắn nó sẽ được ghi vào lịch sử!",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
    {
