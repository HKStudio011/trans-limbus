      "id": 1,
      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Hong Lu",
      "dialog": "Việc này dễ như việc để đám người hầu đút bữa sáng cho tôi vậy.",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 2,
      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Hong Lu",
      "dialog": "Có vẻ như để tôi làm thì sẽ tốt hơn nhỉ!",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Hong Lu",
      "dialog": "Vâng, chà. Cứ làm thôi. Được mà.",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 4,
      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Hong Lu",
      "dialog": "So với tôi... tôi nghĩ những người khác làm sẽ thấy xứng đáng hơn chứ?",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 5,
      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Hong Lu",
      "dialog": "A, tôi vừa nhớ ra mình có việc gấp nên là...",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 6,
      "personalityid": 10601,
      "voiceFile": 0,
      "teller": "Hong Lu",
      "dialog": "Ahaha, đừng khen tôi nhiều như vậy chứ.",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
    {
