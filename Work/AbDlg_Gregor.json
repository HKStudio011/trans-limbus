    {
      "id": 1,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Ồ, tầm này thì có vẻ kết thúc dễ dàng được nhỉ?",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 2,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Hơi phiền phức một chút nhưng... có vẻ là làm được đấy.",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Chà... dù phiền phức thật, nhưng nếu đã bảo làm thì phải làm thôi.",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 4,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Mệnh lệnh à? Nếu được thì giao cho đứa khác đi.",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 5,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "...Gáy của mấy tên cấp trên như ngươi thường hay được tặng kẹo đồng lắm đấy.",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 6,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Hừm, may mắn đấy.",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
    {
      "id": 7,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Cũng có lúc như thế này mà. Làm một điếu không?",
