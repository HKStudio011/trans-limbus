      "personalityid": 11001,
      "voiceFile": 0,
      "teller": "Sinclair",
      "dialog": "Chừng này thì có lẽ tôi cũng làm được.",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 2,
      "personalityid": 11001,
      "voiceFile": 0,
      "teller": "Sinclair",
      "dialog": "...Vâng, tôi sẽ thử.",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 11001,
      "voiceFile": 0,
      "teller": "Sinclair",
      "dialog": "Nếu cần thiết... tôi sẽ thử.",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 4,
      "personalityid": 11001,
      "voiceFile": 0,
      "teller": "Sinclair",
      "dialog": "Có nhất thiết phải là tôi không?",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 5,
      "personalityid": 11001,
      "voiceFile": 0,
      "teller": "Sinclair",
      "dialog": "Là tôi sao? Ngài nghiêm túc chứ? Chắc chắn tôi sẽ thất bại thôi. Sẽ hỏng bét hết cho xem.",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 6,
      "personalityid": 11001,
      "voiceFile": 0,
      "teller": "Sinclair",
      "dialog": "T-tôi làm được rồi... Nhưng tôi không biết lần sau có thành công nữa không.",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
    {
      "id": 7,
      "personalityid": 11001,
      "voiceFile": 0,
      "teller": "Sinclair",
      "dialog": "...Tôi đã nghĩ là sẽ thành ra thế này mà.",
      "usage": "(800101, FAILURE), (800102, FAILURE), (800104, FAILURE), (800105, FAILURE)"
    },
