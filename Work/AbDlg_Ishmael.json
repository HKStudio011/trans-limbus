{
  "dataList": [
    {
      "id": 1,
      "personalityid": 10801,
      "voiceFile": 0,
      "teller": "Ishmael",
      "dialog": "Hỏi tôi có làm được không ư? Đừng có hỏi mấy chuyện hiển nhiên như thế.",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 2,
      "personalityid": 10801,
      "voiceFile": 0,
      "teller": "Ishmael",
      "dialog": "Tầm này thì cũng đáng để làm đấy. Miễn là kế hoạch không phải rác rưởi.",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 10801,
      "voiceFile": 0,
      "teller": "Ishmael",
      "dialog": "Chà... nếu không có ai làm được thì tôi đành phải ra tay thôi.",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 4,
      "personalityid": 10801,
      "voiceFile": 0,
      "teller": "Ishmael",
      "dialog": "Nếu bảo làm thì tôi sẽ làm, nhưng cái kế hoạch này đúng là rác rưởi.",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 5,
      "personalityid": 10801,
      "voiceFile": 0,
      "teller": "Ishmael",
      "dialog": "Ngài tỉnh táo đấy chứ? Hay là phát điên rồi? Tôi thất vọng quá. Đừng có bắt chuyện với tôi nữa.",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 6,
      "personalityid": 10801,
      "voiceFile": 0,
      "teller": "Ishmael",
      "dialog": "Dù sao thì... cũng đã hoàn thành rồi.",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
    {
      "id": 7,
      "personalityid": 10801,
      "voiceFile": 0,
      "teller": "Ishmael",
      "dialog": "Đã bảo là hãy dùng người khác rồi mà. Đừng có đổ lỗi cho tôi đấy.",
      "usage": "(800101, FAILURE), (800102, FAILURE), (800104, FAILURE), (800105, FAILURE)"
    },
